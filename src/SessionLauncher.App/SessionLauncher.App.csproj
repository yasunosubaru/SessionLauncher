<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SessionLauncher.App</RootNamespace>
    <AssemblyName>SessionLauncher</AssemblyName>
    <!-- Taskbar / Explorer icon. Regenerate with tools\make-icon.ps1. -->
    <ApplicationIcon>Assets\SessionLauncher.ico</ApplicationIcon>
    <!-- Deliberately zero PackageReference: this must build with no network access. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\data\TOP-LEVEL-SESSIONS.md">
      <Link>data\TOP-LEVEL-SESSIONS.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
